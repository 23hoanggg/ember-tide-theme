{
  "name": "ember-tide-theme",
  "displayName": "Ember Tide",
  "description": "Warm–cool color themes: Ember Tide (night blue), Light (warm paper), Graphite (neutral gray) and Neon, each with a No Italic version. Also for Zed and terminals.",
  "version": "1.4.0",
  "publisher": "whythohh",
  "author": {
    "name": "Hoang"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/23hoanggg/ember-tide-theme"
  },
  "bugs": {
    "url": "https://github.com/23hoanggg/ember-tide-theme/issues"
  },
  "homepage": "https://github.com/23hoanggg/ember-tide-theme#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "ember",
    "tide",
    "warm",
    "blue",
    "zed",
    "night",
    "terminal",
    "dark theme",
    "light theme",
    "no italic",
    "graphite",
    "neon"
  ],
  "galleryBanner": {
    "color": "#111721",
    "theme": "dark"
  },
  "pricing": "Free",
  "contributes": {
    "themes": [
      {
        "label": "Ember Tide",
        "uiTheme": "vs-dark",
        "path": "./themes/ember-tide-color-theme.json"
      },
      {
        "label": "Ember Tide No Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/ember-tide-noitalic-color-theme.json"
      },
      {
        "label": "Ember Tide Light",
        "uiTheme": "vs",
        "path": "./themes/ember-tide-light-color-theme.json"
      },
      {
        "label": "Ember Tide Light No Italic",
        "uiTheme": "vs",
        "path": "./themes/ember-tide-light-noitalic-color-theme.json"
      },
      {
        "label": "Ember Tide Graphite",
        "uiTheme": "vs-dark",
        "path": "./themes/ember-tide-graphite-color-theme.json"
      },
      {
        "label": "Ember Tide Graphite No Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/ember-tide-graphite-noitalic-color-theme.json"
      },
      {
        "label": "Ember Tide Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/ember-tide-neon-color-theme.json"
      },
      {
        "label": "Ember Tide Neon No Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/ember-tide-neon-noitalic-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "build:zed": "node install.mjs zed",
    "package": "node build.mjs && npx --yes @vscode/vsce package --no-dependencies --out dist/",
    "install:vscode": "node install.mjs vscode",
    "install:all": "node install.mjs",
    "check": "node scripts/check-release.mjs",
    "publish:vscode": "npm test && npm run check && npx --yes @vscode/vsce publish --no-dependencies",
    "publish:ovsx": "npm test && npm run check && npx --yes ovsx publish --no-dependencies",
    "install:terminal": "node install.mjs terminal",
    "test": "node --test \"test/**/*.test.mjs\"",
    "snapshot:update": "node tools/snapshot.mjs --update",
    "install:local": "node install.mjs local"
  }
}
